<Window x:Class="ShoeStore_Kondakov.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Kondakov"
        mc:Ignorable="d"
        Title="MainMenuWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="15,0">
            <Button Width="120" Height="25" Click="Quit_Click">
                Выйти
            </Button>
            <TextBlock x:Name="FIO" FontSize="16" Width="250" Margin="410,0,0,0" VerticalAlignment="Center" FlowDirection="RightToLeft" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="15, 0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="16" Margin="0,0,10,0">Поиск: </TextBlock>
                <TextBox x:Name="searchBox" TextChanged="searchBox_TextChanged" FontSize="14" Width="120" Height="15" />
            </StackPanel>
            <Separator Width="15" Opacity="0" />
            <Border BorderBrush="Chocolate" BorderThickness="1">
                <StackPanel Margin="15, 5" Width="200" Orientation="Vertical">
                    <TextBlock HorizontalAlignment="Center" FontSize="14">
        Сортировка (по кол-ву на складе)
                    </TextBlock>
                    <Separator Opacity="0" Height="3" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button FontSize="14">
                            По возрастанию
                        </Button>
                        <Separator Opacity="0" Width="15" />
                        <Button FontSize="14">
                            По убыванию
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Separator Width="15" Opacity="0" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="14" Margin="0,0,10,0">Поставщик:</TextBlock>
                <ComboBox x:Name="supplierBox" FontSize="14" Width="120" SelectionChanged="supplierBox_SelectionChanged" DisplayMemberPath="Name" />
            </StackPanel>
            <Separator Width="15" Opacity="0" />
            <Button Height="20" FontSize="14">
                Сбросить фильтры
            </Button>
        </StackPanel>
        <ListView Name="ProductsList" Grid.Row="2">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding isDiscount}" Value="True">
                            <Setter Property="Background" Value="#2E8B57" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding isQuantity}" Value="True">
                            <Setter Property="Background" Value="Cyan" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="520" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderThickness="2" Margin="5" BorderBrush="Black">
                                <Image Source="{Binding Photo}" Margin="10" Width="120" />
                            </Border>
                            <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel Margin="5" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProductCategory.Name}" FontWeight="Bold" />
                                        <TextBlock Text=" | " FontWeight="Bold" />
                                        <TextBlock Text="{Binding ProductName.Name}" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Описание товара: " />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Производитель: " />
                                        <TextBlock Text="{Binding Manufacturer.Name}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Поставщик: " />
                                        <TextBlock Text="{Binding Supplier.Name}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: " />
                                        <TextBlock Text="{Binding Price}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding isOnSale}" Value="True">
                                                            <Setter Property="Foreground" Value="Red" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,0" Text="{Binding priceDiscount, StringFormat=Новая цена: {0} руб.}" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Единица измерения: " />
                                        <TextBlock Text="{Binding Unit}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Количество на складе: " />
                                        <TextBlock Text="{Binding Count}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderThickness="2" Margin="5" BorderBrush="Black">
                                <TextBlock Text="{Binding DiscountText}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
