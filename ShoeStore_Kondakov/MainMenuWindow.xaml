<Window x:Class="ShoeStore_Kondakov.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Kondakov"
        mc:Ignorable="d"
        Title="MainMenuWindow" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Выйти из системы" Width="140" Height="28" Click="Quit_Click" VerticalAlignment="Center"/>

            <StackPanel x:Name="AdminActionsPanel" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Button Content="Добавить товар" Height="28" Padding="12,2" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button Content="Удалить выбранное" Height="28" Padding="12,2" Click="BtnDelete_Click"/>
            </StackPanel>

            <TextBlock x:Name="FIO" Grid.Column="2" FontSize="15" VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>

        <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Grid.Row="1" Margin="15, 10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center">Поиск:</TextBlock>
                <TextBox x:Name="searchBox" TextChanged="searchBox_TextChanged" FontSize="14" Width="130" Height="24" VerticalContentAlignment="Center" />
            </StackPanel>

            <Separator Width="15" Opacity="0" />

            <Border BorderBrush="Chocolate" BorderThickness="1">
                <StackPanel Margin="10, 5" Orientation="Vertical">
                    <TextBlock HorizontalAlignment="Center" FontSize="12">Сортировка (по кол-ву на складе)</TextBlock>
                    <Separator Opacity="0" Height="3" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="btnSortAsc" Content="По возрастанию" FontSize="12" Padding="5,2" Click="SortAsc_Click" />
                        <Separator Opacity="0" Width="10" />
                        <Button x:Name="btnSortDesc" Content="По убыванию" FontSize="12" Padding="5,2" Click="SortDesc_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Separator Width="15" Opacity="0" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center">Поставщик:</TextBlock>
                <ComboBox x:Name="supplierBox" FontSize="14" Width="140" Height="24" SelectionChanged="supplierBox_SelectionChanged" DisplayMemberPath="Name" />
            </StackPanel>

            <Separator Width="15" Opacity="0" />

            <Button Content="Сбросить фильтры" Height="26" FontSize="12" Padding="8,2" Click="ResetFilters_Click" VerticalAlignment="Center" />
        </StackPanel>

        <ListView Name="ProductsList" Grid.Row="2" Margin="10" MouseDoubleClick="ProductsList_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding isDiscount}" Value="True">
                            <Setter Property="Background" Value="#2E8B57" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding isQuantity}" Value="True">
                            <Setter Property="Background" Value="Cyan" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderThickness="2" Margin="5" BorderBrush="Black">
                                <Image Source="{Binding FullPhotoPath, 
                                    TargetNullValue='/Assets/picture.png', 
                                    FallbackValue='/Assets/picture.png'}" 
                                    Margin="10" 
                                    Width="120"
                                    Stretch="Uniform"/>
                            </Border>

                            <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel Margin="5" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProductCategory.Name}" FontWeight="Bold" />
                                        <TextBlock Text=" | " FontWeight="Bold" />
                                        <TextBlock Text="{Binding ProductName.Name}" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Описание товара: " />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Производитель: " />
                                        <TextBlock Text="{Binding Manufacturer.Name}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Поставщик: " />
                                        <TextBlock Text="{Binding Supplier.Name}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: " />
                                        <TextBlock Text="{Binding Price}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding isOnSale}" Value="True">
                                                            <Setter Property="Foreground" Value="Red" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,0" Text="{Binding priceDiscount, StringFormat=Новая цена: {0:F2} руб.}" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Единица измерения: " />
                                        <TextBlock Text="{Binding Unit}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Количество на складе: " />
                                        <TextBlock Text="{Binding Count}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderThickness="2" Margin="5" BorderBrush="Black">
                                <TextBlock Text="{Binding DiscountText}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>